NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only guest progress claim issuer. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Legacy projects may set SUPABASE_SERVICE_ROLE_KEY instead.

# Optional. Shown on /contact, /privacy, /for-teachers (pilot requests).
# NEXT_PUBLIC_CONTACT_EMAIL=you@school.bg
# NEXT_PUBLIC_OPERATOR_NAME=Learning Lesson — pilot team

# Optional. Required in Vercel production — comma-separated admin emails.
# Without this in production, admin panel access is blocked even for role=admin.
# ADMIN_EMAIL_ALLOWLIST=admin@school.bg,ops@school.bg

# Temporary maintenance switch for the destructive admin content import.
ENABLE_ADMIN_CONTENT_SEED=0

# Local/CI Playwright only. Never set on any Vercel deployment.
# E2E_FAKE_AUTH=1
# ALLOW_E2E_FAKE_AUTH is ignored on Vercel — fake auth cannot be enabled there.

# Only when Cloudflare sits in front and sets cf-connecting-ip. Never enable on bare Vercel.
# TRUST_CF_CONNECTING_IP=1

# AI mentor (optional — lesson page hint button)
OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
